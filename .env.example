# Copy to .env for local development. Never commit real values.
DATABASE_URL=
# Must be exactly this name -- intelligence/llm.py reads ANTHROPIC_API_KEY
# specifically (see _client()), not a generic LLM_API_KEY.
ANTHROPIC_API_KEY=
APP_BASE_URL=http://localhost:8000
# Exact browser origin allowed by credentialless CORS. No path or trailing slash.
FRONTEND_ORIGIN=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAGINATION_CURSOR_SECRET=
# Subscription routes mount only when this entire production set is present and valid.
# Keep all values empty to leave the routes disabled. Partial configuration fails startup.
# EMAIL_PROVIDER_API_KEY and all three *_KEY values are secrets; never commit their values.
# FORWARDED_ALLOW_IPS is a comma-separated allowlist of trusted proxy IPs/CIDRs; * is forbidden.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
FORWARDED_ALLOW_IPS=
# Environment is one of: dev, test, staging, prod.
# Token key IDs use safe lowercase syntax and begin with the selected environment plus "-".
SUBSCRIPTION_TOKEN_ENVIRONMENT=
SUBSCRIPTION_CONFIRM_KEY_ID=
SUBSCRIPTION_CONFIRM_KEY=
SUBSCRIPTION_UNSUBSCRIBE_KEY_ID=
SUBSCRIPTION_UNSUBSCRIBE_KEY=
SUBSCRIPTION_RATE_LIMIT_KEY=
DOCS_ENABLED=true
LOG_LEVEL=INFO
